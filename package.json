{
  "name": "con-floor-nav",
  "private": true,
  "version": "0.3.12",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:lan": "vite --host",
    "dev:https": "VITE_HTTPS=1 vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "preview:https": "VITE_HTTPS=1 vite preview --host",
    "party-server": "tsx server/party-server.ts",
    "start": "tsx server/party-server.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
